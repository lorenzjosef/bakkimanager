# Bakki API / Web runtime example

# Shared web config
# Use the same-origin `/api/v1` path for local Vite development so auth cookies
# stay first-party through the dev proxy. Override with a full URL only when the
# deployed web app must call a different API origin directly.
VITE_API_BASE_URL=/api/v1

# Desktop runtime config
# Use a full API URL for Electron. Point this at the hosted DigitalOcean API
# origin in packaged/staging/production desktop builds.
BAKKI_DESKTOP_API_BASE_URL=http://127.0.0.1:4175/api/v1

# Odoo Online SaaS
ODOO_URL=https://bakki.odoo.com
ODOO_DB=bakki
# Prefer ODOO_API_KEY for service-to-service access.
ODOO_API_KEY=
# Optional for login/RPC fallback flows if needed later.
ODOO_USERNAME=
ODOO_PASSWORD=

# Bakki Core PostgreSQL/PostGIS
# Use either a full connection string:
BAKKI_CORE_DATABASE_URL=
# Or the discrete fields below:
BAKKI_CORE_DB_HOST=127.0.0.1
BAKKI_CORE_DB_PORT=5432
BAKKI_CORE_DB_NAME=bakki_core
BAKKI_CORE_DB_USER=postgres
BAKKI_CORE_DB_PASSWORD=
BAKKI_CORE_DB_SSL=false
# Leave false in normal environments. Set true only if you intentionally want
# to promote the current non-promotable ranch/zone seed into Bakki Core.
BAKKI_CORE_ALLOW_INVALID_GEOMETRY_SEED=false

# Local development media fallback
# Use `local-filesystem` only for local desktop/web development when Spaces is
# not available. Leave unset in hosted environments so Spaces remains required.
MEDIA_PROVIDER=
LOCAL_MEDIA_ROOT=.local/media

# DigitalOcean Spaces
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
# Optional CDN/public base URL
SPACES_CDN_BASE_URL=
