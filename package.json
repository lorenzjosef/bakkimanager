{
  "name": "bakki",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @bakki/admin-web dev",
    "dev:api": "yarn workspace @bakki/api dev",
    "dev:desktop": "node scripts/run-desktop-dev.mjs",
    "dev:web": "yarn workspace @bakki/admin-web dev",
    "dev:mobile": "yarn workspace @bakki/mobile start",
    "deploy:do:render-spec": "node scripts/render-do-app-spec.mjs",
    "build": "yarn workspace @bakki/admin-web build",
    "build:desktop": "yarn workspace @bakki/admin-web build && yarn workspace @bakki/admin-desktop build",
    "bakki-core:bootstrap": "yarn workspace @bakki/api bakki-core:bootstrap",
    "bakki-core:verify": "yarn workspace @bakki/api bakki-core:verify",
    "env:init-local": "node scripts/init-local-env.mjs",
    "doctor": "yarn workspace @bakki/api doctor",
    "doctor:strict": "yarn workspace @bakki/api doctor:strict",
    "doctor:legacy-odoo": "node scripts/check-legacy-odoo-references.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "web:bundle:check": "node scripts/check-web-bundle.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:mobile": "yarn workspace @bakki/mobile test",
    "media:probe-signing": "yarn workspace @bakki/api media:probe-signing",
    "media:probe-upload": "yarn workspace @bakki/api media:probe-upload",
    "odoo:bootstrap": "yarn workspace @bakki/api odoo:bootstrap",
    "odoo:sync": "yarn workspace @bakki/api odoo:sync",
    "bakki-core:db:doctor": "node scripts/manage-bakki-core-db.mjs doctor",
    "bakki-core:db:up": "node scripts/manage-bakki-core-db.mjs up",
    "bakki-core:db:down": "node scripts/manage-bakki-core-db.mjs down",
    "bakki-core:db:logs": "node scripts/manage-bakki-core-db.mjs logs",
    "test:api": "yarn workspace @bakki/api test",
    "test:web": "yarn workspace @bakki/admin-web test",
    "typecheck": "turbo run typecheck",
    "typecheck:desktop": "yarn workspace @bakki/admin-desktop typecheck",
    "typecheck:mobile": "yarn workspace @bakki/mobile typecheck",
    "seed:geometry": "python3 scripts/build_geometry_seed.py",
    "seed:geometry:inspect": "python3 scripts/build_geometry_seed.py --summary-only",
    "seed:geometry:debug": "python3 scripts/build_geometry_seed.py --summary-only --debug-out docs/seeds/geometry-debug.geojson",
    "seed:geometry:view": "python3 scripts/build_geometry_seed.py --summary-only --debug-out docs/seeds/geometry-debug.geojson --debug-html-out docs/seeds/geometry-debug.html",
    "seed:geometry:validate": "python3 scripts/build_geometry_seed.py --summary-only --check",
    "bakki-core:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-bakki-core.cjs",
    "bakki-core:migrate:dry-run": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-bakki-core.cjs --dry-run",
    "bakki-core:import-areas": "yarn workspace @bakki/api import:areas",
    "bakki-core:export-import-templates": "node --env-file-if-exists=.env --env-file-if-exists=.env.local migrate/export-bakki-tabular-templates.mjs",
    "bakki-core:import-area-metrics": "node --env-file-if-exists=.env --env-file-if-exists=.env.local migrate/import-area-metrics-from-csv.mjs",
    "bakki-core:import-species-inventory": "node --env-file-if-exists=.env --env-file-if-exists=.env.local migrate/import-species-inventory-from-csv.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
